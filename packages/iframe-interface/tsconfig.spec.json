{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "module": "commonjs",
    "moduleResolution": "node16",
    "outDir": "./dist/out-tsc",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["jest", "node"],
    "paths": {
      "@actualwave/deferred-data-access/interface": ["../../packages/deferred-data-access/interface/index.ts"],
      "@actualwave/deferred-data-access": ["../../packages/deferred-data-access/index.ts"]
    }
  },
  "include": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
